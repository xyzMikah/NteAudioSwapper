<Window x:Class="NtePakTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NTE Audio Swapper - Made by MK" Height="640" Width="560"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        Closing="Window_Closing"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1A1A28"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22,18"/>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="#22C55E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe UI Black"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4ADE80"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#1A1A28"/>
                                <Setter Property="Foreground" Value="#333348"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnGhost" TargetType="Button">
            <Setter Property="Background" Value="#1E1E30"/>
            <Setter Property="Foreground" Value="#FBE2B4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#28283C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnClose" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#44445A"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF4466"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Margin="0,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E1E30"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1A2E2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#131321" CornerRadius="22" BorderBrush="#22223A" BorderThickness="1">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="NTE Audio Swapper - Made by MK" Foreground="#FFFFFF"
                               FontFamily="Segoe UI Black" FontSize="17"/>
                    <TextBlock x:Name="TxtWwiseStatus" Text="checking wwise..."
                               Foreground="#44445A" FontFamily="Segoe UI" FontSize="10" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="&#x2715;" Style="{StaticResource BtnClose}"
                        Click="CloseBtn_Click" VerticalAlignment="Top"/>
            </Grid>

            <!-- Step 1: Convert -->
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <StackPanel>
                            <TextBlock Text="WAV TO WEM" Foreground="#FBE2B4"
                                       FontFamily="Segoe UI Black" FontSize="10"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="browse" Style="{StaticResource BtnGhost}"
                                    Click="Browse_Click" Margin="0,0,8,0"/>
                            <Button Content="clear" Style="{StaticResource BtnGhost}"
                                    Click="Clear_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Drop zone + queue combined -->
                    <Border Grid.Row="2" Background="#0D0D1A" CornerRadius="12" MinHeight="80"
                            MaxHeight="160" Cursor="Hand" MouseDown="DropZone_Click">
                        <Grid>
                            <!-- Placeholder shown when queue is empty -->
                            <StackPanel x:Name="DropHint" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,16">
                                <TextBlock Text="drag wav files here or click to browse" Foreground="#2A2A44"
                                           FontFamily="Segoe UI" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <!-- File list shown when queue has items -->
                            <ListBox x:Name="FileQueue" SelectionMode="Extended"
                                     Background="Transparent" BorderThickness="0"
                                     FontFamily="Consolas" FontSize="11"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     Padding="4">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding SourceFileName}" Foreground="#FFFFFF"/>
                                            <TextBlock Text="  →  " Foreground="#FBE2B4"/>
                                            <TextBlock Text="{Binding TargetWem}" Foreground="#60A5FA" FontWeight="Bold"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Step 2: Pack -->
            <Border Grid.Row="4" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="PAK" Foreground="#FBE2B4"
                               FontFamily="Segoe UI Black" FontSize="10"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="name" Foreground="#FBE2B4" FontFamily="Segoe UI"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Border Grid.Column="1" Background="#0D0D1A" CornerRadius="10" Height="36">
                            <TextBox x:Name="TxtModName"
                                     Background="Transparent" Foreground="#FFFFFF"
                                     FontFamily="Consolas" FontSize="12"
                                     BorderThickness="0" Padding="10,0"
                                     VerticalAlignment="Center" VerticalContentAlignment="Center"
                                     Text="AudioMod_P" CaretBrush="#46F0D2"/>
                        </Border>
                        <TextBlock Text=".pak" Grid.Column="2" Foreground="#FBE2B4"
                                   FontFamily="Consolas" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>

                    <Button Grid.Row="4" Content="BUILD" Style="{StaticResource BtnPrimary}"
                            Height="42" FontSize="13" Click="BuildMod_Click" x:Name="BtnBuild"/>
                </Grid>
            </Border>

            <!-- Log -->
            <Border Grid.Row="6" Background="#1A1A28" CornerRadius="14" Padding="14,10">
                <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="TxtLog" Background="Transparent" BorderThickness="0"
                             Foreground="#FFFFFF" FontFamily="Consolas" FontSize="9"
                             IsReadOnly="True" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>

        </Grid>
    </Border>
</Window>
