<Window x:Class="NtePakTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NtePakTool"
        Title="NTE Audio Swapper - Made by MK" Height="720" Width="640"
        MinWidth="340" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Closing="Window_Closing"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True">

    <Window.Resources>

        <!-- ── Palette ─────────────────────────────────────────── -->
        <SolidColorBrush x:Key="BgWindow"  Color="#1F1F30"/>
        <SolidColorBrush x:Key="BgPanel"   Color="#2A2A42"/>
        <SolidColorBrush x:Key="BgInput"   Color="#18182A"/>
        <SolidColorBrush x:Key="BgGhost"   Color="#34344F"/>
        <SolidColorBrush x:Key="BgGhostHi" Color="#41415F"/>
        <SolidColorBrush x:Key="Line"      Color="#38385E"/>
        <SolidColorBrush x:Key="TextDim"   Color="#8A8AAE"/>
        <SolidColorBrush x:Key="Accent"    Color="#60A5FA"/>
        <SolidColorBrush x:Key="Cream"     Color="#FBE2B4"/>
        <SolidColorBrush x:Key="Mint"      Color="#46F0D2"/>
        <SolidColorBrush x:Key="Green"     Color="#22C55E"/>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="#22C55E"/>
            <Setter Property="Foreground" Value="#0B2A16"/>
            <Setter Property="FontFamily" Value="Segoe UI Black"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4ADE80"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#16A34A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#26263A"/>
                                <Setter Property="Foreground" Value="#55556E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnGhost" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgGhost}"/>
            <Setter Property="Foreground" Value="{StaticResource Cream}"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgGhostHi}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title bar icon buttons (minimize / log / close) -->
        <Style x:Key="BtnIcon" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgGhost}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnClose" TargetType="Button" BasedOn="{StaticResource BtnIcon}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF4466"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small round button on the card (remove) -->
        <Style x:Key="BtnCardMini" TargetType="Button">
            <Setter Property="Background" Value="#CC000000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF4466"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter chips -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="Background" Value="{StaticResource BgPanel}"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="Filter"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="12,5">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="#0B1A33"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark right-click menu -->
        <Style x:Key="DarkMenu" TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#2A2A42" BorderBrush="#44445E" BorderThickness="1" CornerRadius="10" Padding="4">
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkMenuItem" TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="#E6E6F5"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="12,7" MinWidth="150">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- #01 alpha = invisible but still catches the mouse, so the rounded corners can be grabbed -->
    <Grid x:Name="RootGrid" Background="#01000000" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
    <Border Background="{StaticResource BgWindow}" CornerRadius="22" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>

        <!-- Toast notification: slides in from right, yellow warning -->
        <Border x:Name="ToastBorder"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,12,12,0"
                Background="#F59E0B"
                CornerRadius="12"
                Padding="14,10"
                MaxWidth="320"
                Panel.ZIndex="100"
                Visibility="Collapsed"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastTranslate" X="400"/>
            </Border.RenderTransform>
            <TextBlock x:Name="ToastText"
                       Foreground="#1A1A00"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       TextWrapping="Wrap"
                       TextOptions.TextFormattingMode="Display"
                       TextOptions.TextRenderingMode="ClearType"/>
        </Border>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 0 title -->
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>  <!-- 2 search + chips -->
                <RowDefinition Height="6"/>
                <RowDefinition Height="*"/>     <!-- 4 cards -->
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>  <!-- 6 pak bar -->
                <RowDefinition Height="Auto"/>  <!-- 7 log -->
            </Grid.RowDefinitions>

            <!-- ── Title Bar ─────────────────────────────────── -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe UI Black" FontSize="18" Foreground="White"
                               TextOptions.TextFormattingMode="Display"
                               TextOptions.TextRenderingMode="ClearType">
                        <Run Text="NTE Audio Swapper"/>
                        <Run Text=" by MK" Foreground="{StaticResource Accent}" FontFamily="Segoe UI Semibold" FontSize="12"/>
                    </TextBlock>
                    <TextBlock x:Name="TxtSubtitle"
                               Text="0 songs swapped"
                               Foreground="{StaticResource TextDim}"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               Margin="0,2,0,0"
                               TextOptions.TextFormattingMode="Display"
                               TextOptions.TextRenderingMode="ClearType"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="BtnLog" Content="&#xE8A5;" Style="{StaticResource BtnIcon}"
                            ToolTip="Show / hide log" Click="LogToggle_Click"/>
                    <Button Content="&#xE921;" Style="{StaticResource BtnIcon}"
                            ToolTip="Minimize" Click="MinBtn_Click"/>
                    <Button Content="&#xE8BB;" Style="{StaticResource BtnClose}"
                            ToolTip="Close" Click="CloseBtn_Click"/>
                </StackPanel>
            </Grid>

            <!-- ── Search + filter chips ─────────────────────── -->
            <StackPanel Grid.Row="2">
                <Border Background="{StaticResource BgInput}" CornerRadius="11" Height="36" Margin="5,0">
                    <Grid>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <TextBlock x:Name="TxtSearchHint" Text="search songs..."
                                   Foreground="#5A5A7A" FontFamily="Segoe UI" FontSize="12"
                                   VerticalAlignment="Center" Margin="34,0,0,0" IsHitTestVisible="False"/>
                        <TextBox x:Name="TxtSearch"
                                 Background="Transparent" Foreground="White"
                                 FontFamily="Segoe UI" FontSize="12"
                                 BorderThickness="0" Padding="30,0,10,0"
                                 VerticalContentAlignment="Center"
                                 CaretBrush="{StaticResource Mint}"
                                 TextChanged="Search_TextChanged"/>
                    </Grid>
                </Border>
                <WrapPanel Margin="5,10,5,0">
                    <RadioButton Style="{StaticResource Chip}" Content="All" Tag="all" IsChecked="True" Checked="Filter_Checked"/>
                    <RadioButton Style="{StaticResource Chip}" Content="Swapped" Tag="assigned" Checked="Filter_Checked"/>
                    <RadioButton Style="{StaticResource Chip}" Content="NTE" Tag="nte" Checked="Filter_Checked"/>
                    <RadioButton Style="{StaticResource Chip}" Content="Persona" Tag="persona" Checked="Filter_Checked"/>
                    <RadioButton Style="{StaticResource Chip}" Content="Tower of Fantasy" Tag="tof" Checked="Filter_Checked"/>
                </WrapPanel>
            </StackPanel>

            <!-- ── Song card grid ────────────────────────────── -->
            <ScrollViewer Grid.Row="4"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="SongGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <local:AnimatedWrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- No DropShadowEffect here: it kills ClearType -->
                            <Border Margin="5"
                                    CornerRadius="14"
                                    Background="{StaticResource BgPanel}"
                                    BorderBrush="{Binding BorderColor}"
                                    BorderThickness="2"
                                    Cursor="Hand"
                                    Width="155"
                                    AllowDrop="True"
                                    Tag="{Binding}"
                                    ToolTip="{Binding TooltipText}"
                                    RenderTransformOrigin="0.5,0.5"
                                    Drop="Card_Drop"
                                    DragOver="Card_DragOver"
                                    DragLeave="Card_DragLeave"
                                    MouseLeftButtonDown="Card_Click">
                                <Border.ContextMenu>
                                    <ContextMenu Style="{StaticResource DarkMenu}">
                                        <MenuItem Style="{StaticResource DarkMenuItem}" Header="{Binding PlayMenuText}" Click="CardMenu_Play"/>
                                        <MenuItem Style="{StaticResource DarkMenuItem}" Header="Replace song..." Click="CardMenu_Replace"/>
                                        <MenuItem Style="{StaticResource DarkMenuItem}" Header="Remove song" Click="CardMenu_Remove"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <EventTrigger RoutedEvent="Border.MouseEnter">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.03" Duration="0:0:0.15">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.03" Duration="0:0:0.15">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="Border.MouseLeave">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.15">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.15">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel>
                                    <!-- Cover area: real rounded top corners via Clip -->
                                    <Grid Height="130" Width="151">
                                        <Grid.Clip>
                                            <PathGeometry Figures="M0,12 A12,12 0 0 1 12,0 L139,0 A12,12 0 0 1 151,12 L151,130 L0,130 Z"/>
                                        </Grid.Clip>

                                        <Image Source="{Binding CoverImage}"
                                               Stretch="UniformToFill"
                                               IsHitTestVisible="False"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>

                                        <!-- dark fade at bottom so the progress bar pops -->
                                        <Rectangle Height="40" VerticalAlignment="Bottom" IsHitTestVisible="False"
                                                   Visibility="{Binding AssignedOverlayVisibility}">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00000000" Offset="0"/>
                                                    <GradientStop Color="#AA000000" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>

                                        <!-- Play / pause bubble -->
                                        <Border Width="46" Height="46" CornerRadius="23"
                                                Background="{Binding PlayBubbleBrush}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding AssignedOverlayVisibility}"
                                                IsHitTestVisible="False">
                                            <TextBlock Text="{Binding PlayGlyph}"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="18"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="{Binding PlayGlyphMargin}"/>
                                        </Border>

                                        <!-- Remove button top-left -->
                                        <Button Style="{StaticResource BtnCardMini}" Content="&#xE711;"
                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,6,0,0"
                                                ToolTip="Remove song"
                                                Visibility="{Binding AssignedOverlayVisibility}"
                                                Click="CardRemove_Click"/>

                                        <!-- AddedSong icon top-right -->
                                        <Image Source="{Binding AddedIcon}"
                                               Width="30" Height="30"
                                               HorizontalAlignment="Right" VerticalAlignment="Top"
                                               Margin="0,5,5,0"
                                               Visibility="{Binding AssignedOverlayVisibility}"
                                               IsHitTestVisible="False"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>

                                        <!-- Progress bar -->
                                        <Rectangle Height="4" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                                   Width="{Binding ProgressWidth}" Fill="{StaticResource Green}"
                                                   IsHitTestVisible="False"/>

                                        <!-- Drag overlay -->
                                        <Border Background="#CC101020"
                                                Visibility="{Binding DragOverVisibility}"
                                                IsHitTestVisible="False">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                                           Foreground="{StaticResource Mint}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Drop audio" Foreground="White"
                                                           FontFamily="Segoe UI Black" FontSize="13" Margin="0,6,0,0"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Text -->
                                    <StackPanel Margin="9,8,9,9">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="White"
                                                   FontFamily="Segoe UI Black"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   TextOptions.TextFormattingMode="Display"
                                                   TextOptions.TextRenderingMode="ClearType"/>
                                        <TextBlock Text="{Binding WemName}"
                                                   Foreground="#6E6E92"
                                                   FontFamily="Consolas"
                                                   FontSize="10"
                                                   Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextOptions.TextFormattingMode="Display"
                                                   TextOptions.TextRenderingMode="ClearType"/>
                                        <Border Background="#1A22C55E" CornerRadius="6" Padding="6,3" Margin="0,6,0,0"
                                                HorizontalAlignment="Left"
                                                Visibility="{Binding AssignedOverlayVisibility}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                           Foreground="{StaticResource Green}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding AssignedFileName}"
                                                           Foreground="#86EFAC"
                                                           FontFamily="Segoe UI Semibold"
                                                           FontSize="10"
                                                           MaxWidth="110"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           TextOptions.TextFormattingMode="Display"
                                                           TextOptions.TextRenderingMode="ClearType"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="click to add song"
                                                   Foreground="#5A5A7A" FontFamily="Segoe UI" FontSize="10"
                                                   Margin="0,6,0,0"
                                                   Visibility="{Binding EmptyHintVisibility}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ── PAK bar ───────────────────────────────────── -->
            <Border Grid.Row="6" Background="{StaticResource BgPanel}" CornerRadius="16" Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="{StaticResource BgInput}" CornerRadius="10" Height="38">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtModName"
                                     Background="Transparent" Foreground="White"
                                     FontFamily="Consolas" FontSize="12"
                                     BorderThickness="0" Padding="10,0,0,0"
                                     VerticalContentAlignment="Center"
                                     Text="AudioMod_P" CaretBrush="{StaticResource Mint}"
                                     ToolTip="Mod name (keep the _P at the end)"/>
                            <TextBlock Grid.Column="1" Text=".pak" Foreground="{StaticResource TextDim}"
                                       FontFamily="Consolas" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                        </Grid>
                    </Border>

                    <Button Grid.Column="2" Content="clear" Style="{StaticResource BtnGhost}"
                            Height="38" Click="ClearAll_Click" ToolTip="Remove all songs"/>

                    <Grid Grid.Column="4">
                        <Button x:Name="BtnRandomize"
                                Content="randomize"
                                Style="{StaticResource BtnGhost}"
                                Height="38"
                                Click="RandomizeBtn_Click"/>
                        <Popup x:Name="RandomizePopup"
                               PlacementTarget="{Binding ElementName=BtnRandomize}"
                               Placement="Top"
                               VerticalOffset="-6"
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Border Background="{StaticResource BgPanel}" CornerRadius="12"
                                    BorderBrush="#44445E" BorderThickness="1"
                                    Padding="6">
                                <StackPanel>
                                    <Button Content="NTE originals" Style="{StaticResource BtnGhost}" Margin="0,3" Height="34" Click="Rand_NTE_Click"/>
                                    <Button Content="Persona (P5 + P5X)" Style="{StaticResource BtnGhost}" Margin="0,3" Height="34" Click="Rand_Persona_Click"/>
                                    <Button Content="Tower of Fantasy" Style="{StaticResource BtnGhost}" Margin="0,3" Height="34" Click="Rand_HT_Click"/>
                                    <Button Content="All songs" Style="{StaticResource BtnGhost}" Margin="0,3" Height="34" Click="Rand_All_Click"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Button Grid.Column="6" Content="BUILD" Style="{StaticResource BtnPrimary}"
                            Height="38" Click="BuildMod_Click" x:Name="BtnBuild"/>
                </Grid>
            </Border>

            <!-- ── Log (hidden by default, toggle in title bar) ─ -->
            <Border x:Name="LogPanel" Grid.Row="7" Background="{StaticResource BgInput}" CornerRadius="14"
                    Padding="14,10" Height="120" Margin="0,10,0,0" Visibility="Collapsed">
                <ScrollViewer x:Name="LogScroller"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBox x:Name="TxtLog" Background="Transparent" BorderThickness="0"
                             Foreground="#B8B8D8" FontFamily="Consolas" FontSize="10"
                             IsReadOnly="True" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>

        </Grid>
        </Grid>
    </Border>
    </Grid>
</Window>
