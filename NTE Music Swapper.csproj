<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>OST.ico</ApplicationIcon>
		<AssemblyName>NTE Music Swapper</AssemblyName>
		<RootNamespace>NtePakTool</RootNamespace>
		<SelfContained>true</SelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<PublishSingleFile>true</PublishSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
	</PropertyGroup>
	<ItemGroup>
		<Content Include="OST.ico" />
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Include="Resources\id.json" />
		<EmbeddedResource Include="Resources\AddedSong.png" />
		<EmbeddedResource Include="Resources\ost.png" />
		<EmbeddedResource Include="Resources\ht_256.png" />
		<EmbeddedResource Include="Resources\nte2_256.png" />
		<EmbeddedResource Include="Resources\p5x_256.png" />
		<EmbeddedResource Include="Resources\p5_256.png" />
		<EmbeddedResource Include="Resources\dummy.sig" />
		<EmbeddedResource Include="Resources\dummy.ucas" />
		<EmbeddedResource Include="Resources\dummy.utoc" />
		<EmbeddedResource Include="Resources\UnrealPak.exe" />
		<EmbeddedResource Include="Resources\WwiseProject\NTE.wproj" />
		<EmbeddedResource Include="Resources\WwiseProject\Conversion Settings\**\*" />
	</ItemGroup>
	<ItemGroup>
	  <None Remove="Resources\dummy.sig" />
	  <None Remove="Resources\dummy.ucas" />
	  <None Remove="Resources\dummy.utoc" />
	</ItemGroup>
</Project>
